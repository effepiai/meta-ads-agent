# Copia questo file in .env solo se usi Supabase per caricare immagini e video (creativita.caricamento_media: supabase).
# Il file .env non va mai condiviso né caricato su Git.
# Consiglio: un progetto Supabase dedicato, con un bucket PUBBLICO usato solo per le creatività.

SUPABASE_URL=https://xxxxxxxx.supabase.co
SUPABASE_KEY=
SUPABASE_BUCKET=creativita-meta
